{
  "functions": {
    "api/proxy.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/((?!proxy).*)",
      "destination": "/api/proxy?prefix=api&path=$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "/api/proxy?prefix=media&path=$1"
    },
    {
      "source": "/((?!api/|media/).*)",
      "destination": "/index.html"
    }
  ]
}
